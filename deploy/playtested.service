[Unit]
Description=Playtested — Verified Player Game Review Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=playtested
Group=playtested
WorkingDirectory=/opt/playtested
EnvironmentFile=/opt/playtested/.env
ExecStart=/usr/bin/node /opt/playtested/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# Basic systemd hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/playtested

[Install]
WantedBy=multi-user.target
