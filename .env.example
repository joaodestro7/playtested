# Core Server
PORT=3000
BASE_URL=http://localhost:3000
MIN_HOURS=2

# Steam (PC) — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Xbox Live — Choose EITHER Option A (Official Microsoft OAuth) OR Option B (OpenXBL)
# Option A: Free Microsoft Azure / Entra App Registration (Personal Microsoft accounts)
#   Redirect URI: ${BASE_URL}/auth/xbox/return
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# Option B: Free OpenXBL API key from https://xbl.io
OPENXBL_KEY=

# Donations ("Buy me a coffee" PayPal link in the footer)
# e.g. https://paypal.me/YourUsername or https://www.paypal.com/donate?hosted_button_id=...
DONATE_URL=

# PlayStation Network (Optional service NPSSO for Profile Bio Verification Challenge)
# Without this, users can still verify directly with their own short-lived NPSSO in RAM.
PSN_NPSSO=

# IGDB Multi-Platform Catalog Sync (Free via Twitch Developer Portal — https://dev.twitch.tv/console)
# Indexes PC, PlayStation, and Xbox games with automatic cross-platform deduplication.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# SteamGridDB Cover Art Fallback (Optional — https://www.steamgriddb.com/profile/preferences/api)
SGDB_KEY=
